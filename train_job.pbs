#!/bin/bash
#PBS -N train_models
#PBS -J 0-3
#PBS -l select=1:ncpus=4:mem=24gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=04:00:00

set -euo pipefail

cd "$PBS_O_WORKDIR"
module purge

export PATH="$HOME/.local/bin:$PATH"
export UV_PYTHON_PREFERENCE=only-managed

if ! command -v uv >/dev/null 2>&1; then
    echo "uv not found; install it on the login node first: curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
    exit 1
fi

uv sync --frozen

.venv/bin/python -c "import torch; print('cuda available:', torch.cuda.is_available())"

SPATIAL_MODULE="train.spatial_transformer.train"
GEO_MODULE="train.geo_transformer.geo_train"

RUNS=(
    "$SPATIAL_MODULE infonce trained_models/spatial_transformer"
    "$SPATIAL_MODULE discriminative trained_models/spatial_transformer"
    "$GEO_MODULE infonce trained_models/geo_transformer"
    "$GEO_MODULE discriminative trained_models/geo_transformer"
)

RUN_INDEX="${PBS_ARRAY_INDEX:-0}"

if [ "$RUN_INDEX" -ge "${#RUNS[@]}" ]; then
    echo "no run for array index $RUN_INDEX (have ${#RUNS[@]})" >&2
    exit 1
fi

read -r module loss output_dir <<< "${RUNS[$RUN_INDEX]}"
echo "=== run $RUN_INDEX: $module --loss $loss -> $output_dir ==="

.venv/bin/python -m "$module" --loss "$loss" --output-dir "$output_dir"
