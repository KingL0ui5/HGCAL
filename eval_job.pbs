#!/bin/bash
#PBS -N eval_models
#PBS -o evals/data/logs/
#PBS -e evals/data/logs/
#PBS -l select=1:ncpus=4:mem=24gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=04:00:00

set -euo pipefail

cd "$PBS_O_WORKDIR"
module purge

export PATH="$HOME/.local/bin:$PATH"
export UV_PYTHON_PREFERENCE=only-managed

if ! command -v uv >/dev/null 2>&1; then
    echo "uv not found; install it on the login node first: curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
    exit 1
fi

GEO_MODULE="evals.geo_transformer.geo_transformer_eval"
SPATIAL_MODULE="evals.spatial_transformer.spatial_eval"

EVAL_SET="${EVAL_SET:-all}"

latest_spatial_checkpoint() {
    ls -t trained_models/spatial_transformer/spatial_"$1"_*_best.pt 2>/dev/null | head -n 1 || true
}

EXISTING_EVALS=(
    "$GEO_MODULE trained_models/geo_transformer/geo_infonce_20261112_070054_best.pt"
    "$GEO_MODULE trained_models/geo_transformer/geo_discriminative_20261109_143754_best.pt"
)

SPATIAL_EVALS=(
    "$SPATIAL_MODULE $(latest_spatial_checkpoint infonce)"
    "$SPATIAL_MODULE $(latest_spatial_checkpoint discriminative)"
)

case "$EVAL_SET" in
    all) EVALS=("${EXISTING_EVALS[@]}" "${SPATIAL_EVALS[@]}") ;;
    spatial) EVALS=("${SPATIAL_EVALS[@]}") ;;
    existing) EVALS=("${EXISTING_EVALS[@]}") ;;
    *) echo "unknown EVAL_SET: $EVAL_SET (use all, spatial or existing)" >&2; exit 1 ;;
esac

mkdir -p evals/data/geo_transformer_runs evals/data/spatial_transformer_runs

uv sync --frozen

.venv/bin/python -c "import torch; print('cuda available:', torch.cuda.is_available())"

failed=0

for entry in "${EVALS[@]}"; do
    read -r module checkpoint <<< "$entry"

    if [ -z "$checkpoint" ] || [ ! -f "$checkpoint" ]; then
        echo "checkpoint not found: $checkpoint" >&2
        failed=$((failed + 1))
        continue
    fi

    case "$module" in
        "$SPATIAL_MODULE") runs_dir="evals/data/spatial_transformer_runs" ;;
        *) runs_dir="evals/data/geo_transformer_runs" ;;
    esac

    run_name="$(basename "$checkpoint" .pt)"
    echo "=== evaluating $checkpoint with $module ==="

    if ! .venv/bin/python -m "$module" --checkpoint "$checkpoint" 2>&1 | tee "$runs_dir/eval_${run_name}_${PBS_JOBID}.out"; then
        echo "eval failed: $checkpoint" >&2
        failed=$((failed + 1))
    fi
done

echo "evals finished, failures: $failed"

exit "$failed"
